// ============================================================
function verificarSenha(email) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName('clientes');
    
    if (!sheet) {
      return '❌ Aba "clientes" não encontrada';
    }
    
    const cabecalhos = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    const colunaEmail = cabecalhos.indexOf('email') + 1;
    const colunaSenha = cabecalhos.indexOf('senha') + 1;
    const colunaNome = cabecalhos.indexOf('nome') + 1;
    
    if (colunaSenha === 0) {
      return '❌ Coluna "senha" não encontrada! Execute "criarAbas()" para recriar.';
    }
    
    for (let i = 2; i <= sheet.getLastRow(); i++) {
      const emailCelula = sheet.getRange(i, colunaEmail).getValue();
      if (emailCelula === email) {
        const senhaCelula = sheet.getRange(i, colunaSenha).getValue();
        const nomeCelula = sheet.getRange(i, colunaNome).getValue();
        return `✅ Cliente encontrado!\nNome: ${nomeCelula}\nEmail: ${email}\nSenha salva: ${senhaCelula ? '✅ Sim (' + senhaCelula + ')' : '❌ Não'}`;
      }
    }
    
    return `❌ Cliente com email "${email}" não encontrado`;
    
  } catch (error) {
    return '❌ ERRO: ' + error.message;
  }
}

