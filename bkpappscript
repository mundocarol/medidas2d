function criarAbaProspeccao() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('prospeccao');
  
  if (sheet) {
    const msg = 'ℹ️ A aba "prospeccao" já existe!\n\nLinhas: ' + sheet.getLastRow();
    console.log(msg);
    SpreadsheetApp.getUi().alert(msg);
    return msg;
  }
  
  sheet = ss.insertSheet('prospeccao');
  
  const cabecalhos = [
    'id',
    'cliente_id',
    'cliente_nome',
    'cliente_telefone',
    'cliente_email',
    'data_hora',
    'resultado',
    'observacoes',
    'prospectador',
    'timestamp'
  ];
  
  sheet.getRange(1, 1, 1, cabecalhos.length).setValues([cabecalhos]);
  sheet.getRange(1, 1, 1, cabecalhos.length)
    .setFontWeight('bold')
    .setBackground('#1a3a5c')
    .setFontColor('white')
    .setHorizontalAlignment('center');
  
  sheet.setFrozenRows(1);
  sheet.autoResizeColumns(1, cabecalhos.length);
  
  // Formata a coluna de data como texto para não bugar o formato brasileiro
  sheet.getRange(2, 6, sheet.getMaxRows() - 1, 1).setNumberFormat('@STRING@');
  sheet.getRange(2, 10, sheet.getMaxRows() - 1, 1).setNumberFormat('@STRING@');
  
  const msg = '✅ Aba "prospeccao" criada com sucesso!\n\nColunas: ' + cabecalhos.length + '\nPronta para receber contatos.';
  console.log(msg);
  SpreadsheetApp.getUi().alert(msg);
  return msg;
}
