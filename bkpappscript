// ============================================================
// 1.1 FUNÇÃO PROXY PARA SUPERFRETE
// ============================================================
function calcularFreteSuperFrete(cepDestino, peso, altura, largura, comprimento) {
  try {
    if (!cepDestino || cepDestino.length < 8) {
      return {
        success: false,
        error: 'CEP de destino inválido',
        opcoes: []
      };
    }
    
    if (peso <= 0 || altura <= 0 || largura <= 0 || comprimento <= 0) {
      return {
        success: false,
        error: 'Dimensões inválidas',
        opcoes: []
      };
    }
    
    const alturaFinal = Math.max(altura, 2);
    const larguraFinal = Math.max(largura, 11);
    const comprimentoFinal = Math.max(comprimento, 16);
    
    const payload = {
      from: {
        postal_code: CEP_ORIGEM.replace(/\D/g, '')
      },
      to: {
        postal_code: cepDestino.replace(/\D/g, '')
      },
      services: '1,2,3,31',
      options: {
        own_hand: false,
        receipt: false,
        insurance_value: 0,
        use_insurance_value: false
      },
      package: {
        height: alturaFinal,
        width: larguraFinal,
        length: comprimentoFinal,
        weight: peso
      }
    };
    
    console.log('📤 Enviando para SuperFrete:', JSON.stringify(payload));
    
    const url = 'https://api.superfrete.com/api/v0/calculator';
    
    const options = {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + SUPERFRETE_TOKEN,
        'User-Agent': 'MC Embalagens BH (mundocarolpresentes@gmail.com)'
      },
      payload: JSON.stringify(payload),
      muteHttpExceptions: true
    };
    
    const response = UrlFetchApp.fetch(url, options);
    const statusCode = response.getResponseCode();
    const responseText = response.getContentText();
    
    console.log('📥 Status:', statusCode);
    
    if (statusCode === 200) {
      try {
        const data = JSON.parse(responseText);
        console.log('✅ Resposta recebida com sucesso!');
        
        let opcoesFormatadas = [];
        if (Array.isArray(data) && data.length > 0) {
          opcoesFormatadas = data.map(item => {
            const nomesServicos = {
              1: 'PAC',
              2: 'SEDEX',
              3: 'Jadlog',
              17: 'Mini Envios',
              31: 'Loggi'
            };
            
            return {
              service: nomesServicos[item.id] || item.name || 'Frete',
              price: parseFloat(item.price) || 0,
              delivery_time: parseInt(item.delivery_time) || 0,
              service_code: String(item.id || ''),
              nome: nomesServicos[item.id] || item.name || 'Frete',
              preco: parseFloat(item.price) || 0,
              prazo: parseInt(item.delivery_time) || 0,
              codigo: String(item.id || ''),
              empresa: item.company?.name || '',
              has_error: item.has_error || false
            };
          });
        }
        
        if (opcoesFormatadas.length > 0) {
          return {
            success: true,
            opcoes: opcoesFormatadas,
            status: statusCode
          };
        } else {
          console.log('⚠️ Nenhuma opção encontrada na resposta');
        }
      } catch (e) {
        console.log('❌ Erro ao parsear JSON:', e.toString());
      }
    } else if (statusCode === 400 || statusCode === 500) {
      try {
        const data = JSON.parse(responseText);
        let mensagemErro = 'Erro na requisição';
        if (data.message) mensagemErro = data.message;
        if (data.errors) {
          const errors = Object.values(data.errors).flat().join(' | ');
          mensagemErro += ' - ' + errors;
        }
        console.log('❌', mensagemErro);
      } catch (e) {
        console.log('❌ Resposta de erro:', responseText);
      }
    }
    
    console.log('⚠️ Usando fallback com valores simulados');
    return {
      success: true,
      opcoes: gerarOpcoesFallback(cepDestino, peso, alturaFinal, larguraFinal, comprimentoFinal),
      warning: 'Usando fallback'
    };
    
  } catch (error) {
    console.error('❌ Erro:', error.toString());
    return {
      success: true,
      opcoes: gerarOpcoesFallback(cepDestino, peso, altura, largura, comprimento),
      warning: 'Erro: ' + error.toString()
    };
  }
}

// ============================================================
// FUNÇÃO DE FALLBACK PARA QUANDO A API NÃO RESPONDER
// ============================================================
function gerarOpcoesFallback(cepDestino, peso, altura, largura, comprimento) {
  const cepNum = parseInt(cepDestino.replace(/\D/g, '')) || 0;
  const cepOrigemNum = parseInt(CEP_ORIGEM.replace(/\D/g, '')) || 0;
  const distancia = Math.abs(cepNum - cepOrigemNum) / 100000;
  const prazoBase = Math.max(2, Math.min(10, Math.floor(distancia * 3) + 2));
  
  let valorPac = 15.90 + (peso * 1.5) + (distancia * 2);
  valorPac = Math.round(valorPac * 100) / 100;
  valorPac = Math.max(valorPac, 10);
  const prazoPac = Math.min(prazoBase + 3, 12);
  
  let valorSedex = 32.50 + (peso * 2.5) + (distancia * 3);
  valorSedex = Math.round(valorSedex * 100) / 100;
  valorSedex = Math.max(valorSedex, 20);
  const prazoSedex = Math.min(prazoBase + 1, 5);
  
  let valorTransportadora = 45.00 + (peso * 1.8) + (distancia * 1.5);
  valorTransportadora = Math.round(valorTransportadora * 100) / 100;
  valorTransportadora = Math.max(valorTransportadora, 30);
  const prazoTransportadora = Math.min(prazoBase + 5, 15);
  
  return [
    {
      service: 'PAC',
      nome: 'PAC',
      price: valorPac,
      preco: valorPac,
      delivery_time: prazoPac,
      prazo: prazoPac,
      service_code: '04510',
      codigo: '04510',
      _fallback: true
    },
    {
      service: 'SEDEX',
      nome: 'SEDEX',
      price: valorSedex,
      preco: valorSedex,
      delivery_time: prazoSedex,
      prazo: prazoSedex,
      service_code: '04014',
      codigo: '04014',
      _fallback: true
    },
    {
      service: 'Transportadora',
      nome: 'Transportadora',
      price: valorTransportadora,
      preco: valorTransportadora,
      delivery_time: prazoTransportadora,
      prazo: prazoTransportadora,
      service_code: 'TRANSP',
      codigo: 'TRANSP',
      _fallback: true
    }
  ];
}

