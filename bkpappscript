// CALCULAR E SALVAR FRETE NA PLANILHA
// ============================================================
function salvarFreteNaPlanilha(cepDestino, peso, altura, largura, comprimento, produtosCarrinho) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let sheet = ss.getSheetByName('fretes_calculados');
    
    if (!sheet) {
      sheet = ss.insertSheet('fretes_calculados');
      const cabecalhos = [
        'id', 'timestamp', 'cep_destino', 'peso', 'altura', 'largura', 'comprimento',
        'produtos_carrinho',
        'opcao_1_nome', 'opcao_1_valor', 'opcao_1_prazo',
        'opcao_2_nome', 'opcao_2_valor', 'opcao_2_prazo',
        'opcao_3_nome', 'opcao_3_valor', 'opcao_3_prazo',
        'opcao_4_nome', 'opcao_4_valor', 'opcao_4_prazo',
        'opcao_5_nome', 'opcao_5_valor', 'opcao_5_prazo'
      ];
      sheet.getRange(1, 1, 1, cabecalhos.length).setValues([cabecalhos]);
      sheet.getRange(1, 1, 1, cabecalhos.length).setFontWeight('bold');
      sheet.setFrozenRows(1);
    }
    
    // 🔥 GARANTE QUE A COLUNA produtos_carrinho EXISTE
    let cabecalhos = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    let colProdutos = cabecalhos.indexOf('produtos_carrinho') + 1;
    if (colProdutos === 0) {
      colProdutos = cabecalhos.length + 1;
      sheet.getRange(1, colProdutos).setValue('produtos_carrinho');
      sheet.getRange(1, colProdutos).setFontWeight('bold');
      cabecalhos = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
      colProdutos = cabecalhos.indexOf('produtos_carrinho') + 1;
      console.log('✅ Coluna produtos_carrinho criada na posição', colProdutos);
    }
    
    const resultado = calcularFreteSuperFrete(cepDestino, peso, altura, largura, comprimento);
    const opcoes = resultado.opcoes || [];
    const id = Date.now();
    
    // 🔥 TIMESTAMP FORMATADO CORRETAMENTE (America/Sao_Paulo)
    const timestamp = dataHoraBrasilia("dd/MM/yyyy HH:mm:ss");
    
    // 🔥 LIMPA LINHAS ANTIGAS (mantém últimas 200)
    if (sheet.getLastRow() > 200) {
      const totalLinhas = sheet.getLastRow();
      sheet.deleteRows(2, totalLinhas - 200);
    }
    
    // 🔥 MONTA A LINHA COMPLETA USANDO OS CABEÇALHOS COMO REFERÊNCIA
    const novaLinha = [];
    cabecalhos.forEach(nomeColuna => {
      switch(nomeColuna) {
        case 'id':
          novaLinha.push(id);
          break;
        case 'timestamp':
          novaLinha.push(timestamp);
          break;
        case 'cep_destino':
          novaLinha.push(cepDestino);
          break;
        case 'peso':
          novaLinha.push(peso);
          break;
        case 'altura':
          novaLinha.push(altura);
          break;
        case 'largura':
          novaLinha.push(largura);
          break;
        case 'comprimento':
          novaLinha.push(comprimento);
          break;
        case 'produtos_carrinho':
          novaLinha.push(produtosCarrinho || '');
          break;
        default:
          // 🔥 COLUNAS DE OPÇÕES (opcao_1_nome, opcao_1_valor, etc)
          const matchOpcao = nomeColuna.match(/^opcao_(\d+)_(nome|valor|prazo)$/);
          if (matchOpcao) {
            const numOpcao = parseInt(matchOpcao[1]) - 1;
            const tipo = matchOpcao[2];
            
            if (opcoes[numOpcao]) {
              if (tipo === 'nome') {
                novaLinha.push(opcoes[numOpcao].nome || opcoes[numOpcao].service || 'Frete');
              } else if (tipo === 'valor') {
                novaLinha.push(opcoes[numOpcao].preco || opcoes[numOpcao].price || 0);
              } else if (tipo === 'prazo') {
                novaLinha.push(opcoes[numOpcao].prazo || opcoes[numOpcao].delivery_time || 0);
              }
            } else {
              novaLinha.push(tipo === 'valor' || tipo === 'prazo' ? 0 : '');
            }
          } else {
            novaLinha.push('');
          }
      }
    });
    
    const linha = sheet.getLastRow() + 1;
    sheet.getRange(linha, 1, 1, novaLinha.length).setValues([novaLinha]);
    
    console.log('✅ Frete salvo na linha', linha, '- produtos:', produtosCarrinho);
    
    return {
      success: true,
      id: id,
      mensagem: 'Frete calculado e salvo!',
      opcoes: opcoes
    };
    
  } catch (error) {
    console.error('❌ Erro ao salvar frete:', error);
    return {
      success: false,
      erro: error.toString()
    };
  }
}

// ============================================================
// BUSCAR ÚLTIMO FRETE CALCULADO
// ============================================================
function buscarUltimoFrete() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName('fretes_calculados');
    
    if (!sheet || sheet.getLastRow() < 2) {
      return {
        success: false,
        mensagem: 'Nenhum frete calculado ainda'
      };
    }
    
    const ultimaLinha = sheet.getLastRow();
    const dados = sheet.getRange(ultimaLinha, 1, 1, sheet.getLastColumn()).getValues()[0];
    const cabecalhos = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    
    const opcoes = [];
    for (let i = 0; i < 5; i++) {
      const idxNome = cabecalhos.indexOf(`opcao_${i+1}_nome`) + 1;
      const idxValor = cabecalhos.indexOf(`opcao_${i+1}_valor`) + 1;
      const idxPrazo = cabecalhos.indexOf(`opcao_${i+1}_prazo`) + 1;
      
      if (idxNome > 0 && dados[idxNome-1]) {
        opcoes.push({
          nome: dados[idxNome-1],
          preco: parseFloat(dados[idxValor-1] || 0),
          prazo: parseInt(dados[idxPrazo-1] || 0),
          codigo: dados[idxNome-1].substring(0, 10).toUpperCase()
        });
      }
    }
    
    return {
      success: true,
      opcoes: opcoes,
      cep: dados[cabecalhos.indexOf('cep_destino')],
      peso: dados[cabecalhos.indexOf('peso')],
      timestamp: dados[cabecalhos.indexOf('timestamp')]
    };
    
  } catch (error) {
    return {
      success: false,
      erro: error.toString()
    };
  }
