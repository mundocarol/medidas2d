// ============================================================
// CRIA LINK DE PAGAMENTO (COM MÉTODO ESCOLHIDO)
// ============================================================
function criarLinkPagamento(dados) {
  try {
    var secretKey = PropertiesService.getScriptProperties().getProperty('PAGARME_SECRET_KEY');
    
    if (!secretKey) {
      console.error('❌ Chave secreta não configurada');
      return {
        success: false,
        error: 'Chave secreta não configurada'
      };
    }
    
    if (!dados.itens || dados.itens.length === 0) {
      return {
        success: false,
        error: 'Nenhum item para criar o link'
      };
    }
    
    var items = [];
    var totalCentavos = 0;
    
    for (var i = 0; i < dados.itens.length; i++) {
      var item = dados.itens[i];
      var preco = parseFloat(item.price) || 0;
      var precoCentavos = Math.round(preco * 100);
      totalCentavos += precoCentavos;
      
      items.push({
        name: String(item.nome || 'Produto').substring(0, 100),
        amount: precoCentavos,
        default_quantity: 1
      });
    }
    
    var metodos = dados.metodosPagamento || ['pix'];
    var temCartao = metodos.indexOf('credit_card') !== -1;
    var temPix = metodos.indexOf('pix') !== -1;
    var temBoleto = metodos.indexOf('boleto') !== -1;
    
    var paymentSettings = {
      accepted_payment_methods: metodos
    };
    
    if (temPix) {
      paymentSettings.pix_settings = {
        expires_in: 60
      };
    }
    
    if (temBoleto) {
      paymentSettings.boleto_settings = {
        due_in: 3,
        instructions: 'Pagamento via Boleto Bancário'
      };
    }
    
    if (temCartao) {
      var installments = [];
      installments.push({ number: 1, total: totalCentavos });
      
      var TAXA_JUROS = 0.0239;
      var totalReais = totalCentavos / 100;
      
      for (var parcela = 2; parcela <= 6; parcela++) {
        var fator = Math.pow(1 + TAXA_JUROS, parcela);
        var valorParcela = (totalReais * fator) / parcela;
        var totalComJuros = Math.round(valorParcela * parcela * 100);
        installments.push({
          number: parcela,
          total: totalComJuros
        });
      }
      
      paymentSettings.credit_card_settings = {
        operation_type: 'auth_and_capture',
        installments: installments
      };
    }
    
    var documento = String(dados.clienteDocumento || '').replace(/\D/g, '');
    var documentType = 'cpf';
    
    if (documento.length === 14) {
      documentType = 'cnpj';
    } else if (documento.length !== 11) {
      documento = '12345678909';
      documentType = 'cpf';
    }
    
    var telefone = String(dados.clienteTelefone || '').replace(/\D/g, '');
    if (telefone.length < 10) {
      telefone = '31999999999';
    }
    
    var endereco = String(dados.clienteEndereco || 'Rua Teste');
    var numero = String(dados.clienteNumero || '123');
    var bairro = String(dados.clienteBairro || 'Centro');
    var cidade = String(dados.clienteCidade || 'Belo Horizonte');
    var uf = String(dados.clienteUf || 'MG').toUpperCase().substring(0, 2);
    var cep = String(dados.clienteCep || '30100000').replace(/\D/g, '').substring(0, 8);
    
    var payload = {
      type: 'order',
      payment_settings: paymentSettings,
      cart_settings: {
        items: items,
        expires_in: 7
      },
      customer_settings: {
        name: String(dados.clienteNome || 'Cliente').substring(0, 100),
        email: String(dados.clienteEmail || 'cliente@email.com').substring(0, 100),
        document: documento,
        document_type: documentType,
        phone: {
          country_code: '55',
          number: telefone
        }
      },
      billing: {
        name: String(dados.clienteNome || 'Cliente').substring(0, 100),
        address: {
          country: 'BR',
          state: uf,
          city: cidade,
          neighborhood: bairro,
          street: endereco,
          street_number: numero,
          zipcode: cep
        }
      },
      shipping: {
        name: String(dados.clienteNome || 'Cliente').substring(0, 100),
        address: {
          country: 'BR',
          state: uf,
          city: cidade,
          neighborhood: bairro,
          street: endereco,
          street_number: numero,
          zipcode: cep
        }
      },
      metadata: {
        pedido_id: String(dados.pedidoId || '')
      }
    };
    
    console.log('📤 Payload enviado:', JSON.stringify(payload, null, 2));
    
    var url = 'https://api.pagar.me/core/v5/paymentlinks';
    var options = {
      method: 'post',
      headers: {
        'Authorization': 'Basic ' + Utilities.base64Encode(secretKey + ':'),
        'Content-Type': 'application/json'
      },
      payload: JSON.stringify(payload),
      muteHttpExceptions: true,
      timeout: 30000
    };
    
    var response = UrlFetchApp.fetch(url, options);
    var statusCode = response.getResponseCode();
    var content = response.getContentText();
    
    console.log('📥 Status Code:', statusCode);
    console.log('📥 Resposta:', content);
    
    if (!content || content.length === 0) {
      return {
        success: false,
        error: 'Resposta vazia da API',
        statusCode: statusCode
      };
    }
    
    try {
      var result = JSON.parse(content);
      
      if (statusCode === 200 || statusCode === 201) {
        var pixData = null;
        var boletoData = null;
        var cartaoData = null;
        
        if (result.payment_settings && result.payment_settings.pix_settings) {
          var pixSettings = result.payment_settings.pix_settings;
          
          var qrCode = null;
          var copiaCola = null;
          
          if (pixSettings.qr_code) qrCode = pixSettings.qr_code;
          if (pixSettings.qr_code_text) copiaCola = pixSettings.qr_code_text;
          if (!qrCode && result.qr_code) qrCode = result.qr_code;
          if (!copiaCola && result.qr_code_text) copiaCola = result.qr_code_text;
          
          if (qrCode || copiaCola) {
            pixData = {
              qrCode: qrCode || null,
              copiaCola: copiaCola || null,
              expiresIn: pixSettings.expires_in || 60
            };
            console.log('✅ Dados do PIX extraídos');
          } else {
            console.log('⚠️ Nenhum dado PIX encontrado');
          }
        }
        
        if (result.payment_settings && result.payment_settings.boleto_settings) {
          var boletoSettings = result.payment_settings.boleto_settings;
          boletoData = {
            url: boletoSettings.boleto_url || null,
            barcode: boletoSettings.barcode || null
          };
        }
        
        if (result.payment_settings && result.payment_settings.credit_card_settings) {
          cartaoData = {
            available: true,
            maxInstallments: result.payment_settings.credit_card_settings.max_installments || 6
          };
        }
        
        return {
          success: true,
          paymentLink: result.url,
          checkoutId: result.id,
          status: result.status,
          pix: pixData,
          boleto: boletoData,
          cartao: cartaoData,
          total: totalCentavos,
          totalFormatado: (totalCentavos / 100).toFixed(2),
          items: result.cart_settings?.items || [],
          createdAt: result.created_at
        };
        
      } else {
        var mensagemErro = result.message || 'Erro ao criar link';
        if (result.errors) {
          var erros = [];
          for (var key in result.errors) {
            erros.push(key + ': ' + result.errors[key].join(', '));
          }
          mensagemErro += ' | ' + erros.join('; ');
        }
        return {
          success: false,
          error: mensagemErro,
          details: result,
          statusCode: statusCode
        };
      }
      
    } catch (parseError) {
      console.error('❌ Erro ao parsear JSON:', parseError.message);
      return {
        success: false,
        error: 'Erro ao processar resposta: ' + parseError.message,
        rawResponse: content
      };
    }
    
  } catch (error) {
    console.error('❌ Erro em criarLinkPagamento:', error);
    return {
      success: false,
      error: error.message || 'Erro ao processar requisição',
      stack: error.stack
    };
  }
}

// ============================================================
// VERIFICAR STATUS DO PAGAMENTO
// ============================================================
function verificarStatusPagamento(checkoutId) {
  try {
    if (!checkoutId) {
      return {
        success: false,
        error: 'ID do checkout não informado'
      };
    }
    
    var secretKey = PropertiesService.getScriptProperties().getProperty('PAGARME_SECRET_KEY');
    
    if (!secretKey) {
      return {
        success: false,
        error: 'Chave secreta do Pagar.me não configurada'
      };
    }
    
    var url = 'https://api.pagar.me/core/v5/paymentlinks/' + checkoutId;
    var options = {
      method: 'get',
      headers: {
        'Authorization': 'Basic ' + Utilities.base64Encode(secretKey + ':'),
        'Content-Type': 'application/json'
      },
      muteHttpExceptions: true
    };
    
    var response = UrlFetchApp.fetch(url, options);
    var result = JSON.parse(response.getContentText());
    
    if (response.getResponseCode() !== 200) {
      return {
        success: false,
        error: result.message || 'Erro ao verificar status do pagamento'
      };
    }
    
    var status = result.status || 'pending';
    var isPaid = status === 'paid';
    
    return {
      success: true,
      status: status,
      isPaid: isPaid,
      paymentLink: result.url,
      expiresAt: result.expires_at
    };
    
  } catch (error) {
    return {
      success: false,
      error: error.message || 'Erro ao verificar status'
    };
  }
}

