      for (const [campo, nomeColuna] of Object.entries(campos)) {
        const coluna = cabecalhos.indexOf(nomeColuna) + 1;
        if (coluna > 0 && novosDados[campo] !== undefined) {
          sheet.getRange(linha, coluna).setValue(novosDados[campo]);
        }
      }
      
      return criarResposta({
        sucesso: true,
        mensagem: 'Dados do cliente atualizados com sucesso!'
      });
    }
    
    // ============================================================
    // 2.12 SALVAR FRETE NA PLANILHA (COM PRODUTOS DO CARRINHO)
    // ============================================================
    if (acao === 'salvar_frete') {
      console.log('📥 Salvando frete na planilha...');
      console.log('📦 Produtos do carrinho:', dados.produtos_carrinho || '(não informado)');
      
      const resultado = salvarFreteNaPlanilha(
        dados.cepDestino,
        parseFloat(dados.peso) || 0.5,
        parseFloat(dados.altura) || 10,
        parseFloat(dados.largura) || 10,
        parseFloat(dados.comprimento) || 10,
        dados.produtos_carrinho || ''
      );
      console.log('📤 Resultado:', resultado);
      return criarResposta(resultado);
    }
    
    // ============================================================
    // 2.13 ATUALIZAR ESTOQUE MÚLTIPLO
    // ============================================================
    if (acao === 'atualizar_estoque_multiplo') {
      const sheet = ss.getSheetByName('produtos');
      
      if (!sheet) {
        throw new Error('Aba "produtos" não encontrada');
      }
      
      const cabecalhos = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
      const colunaEstoque = cabecalhos.indexOf('estoque') + 1;
      const colunaId = cabecalhos.indexOf('id') + 1;
      const colunaDataEstoque = cabecalhos.indexOf('data_estoque') + 1;
      const dataAtual = dataHoraBrasilia("dd/MM/yyyy");
      
      const itens = dados.itens || {};
      
      for (const [productId, atualizacao] of Object.entries(itens)) {
        const id = parseInt(productId);
        const novoEstoque = parseInt(atualizacao.estoque);
        
        for (let i = 2; i <= sheet.getLastRow(); i++) {
          const idCelula = sheet.getRange(i, colunaId).getValue();
          if (parseInt(idCelula) === id) {
            sheet.getRange(i, colunaEstoque).setValue(novoEstoque);
            if (colunaDataEstoque > 0) {
              sheet.getRange(i, colunaDataEstoque).setValue(dataAtual);
            }
            break;
          }
        }
      }
      
      return criarResposta({
        sucesso: true,
        mensagem: 'Estoque atualizado com sucesso!'
      });
    }
    
    // ============================================================
    // 2.14 CRIAR LINK DE PAGAMENTO PAGAR.ME
    // ============================================================
    if (acao === 'criar_link_pagamento') {
      console.log('📥 Criando link de pagamento...');
      var resultado = criarLinkPagamento(dados.dados);
      console.log('📤 Resultado:', resultado);
      return criarResposta(resultado);
    }
    
    // ============================================================
    // 2.15 ATUALIZAR OBSERVAÇÕES DO PEDIDO
    // ============================================================
    if (acao === 'atualizar_observacoes_pedido') {
      const sheet = ss.getSheetByName('pedidos');
      
      if (!sheet) {
        throw new Error('Aba "pedidos" não encontrada');
      }
      
      const cabecalhos = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
      const colunaId = cabecalhos.indexOf('id_pedido') + 1;
      const colunaObservacoes = cabecalhos.indexOf('observacoes') + 1;
      
      if (colunaObservacoes === 0) {
        throw new Error('Coluna "observacoes" não encontrada na aba "pedidos"!');
      }
      
      const idPedido = parseInt(dados.id_pedido);
      const novasObservacoes = dados.observacoes || '';
      
      let encontrado = false;
      for (let i = 2; i <= sheet.getLastRow(); i++) {
        const idCelula = sheet.getRange(i, colunaId).getValue();
        if (parseInt(idCelula) === idPedido) {
          sheet.getRange(i, colunaObservacoes).setValue(novasObservacoes);
          encontrado = true;
          console.log(`✅ Observações atualizadas para o pedido #${idPedido}:`, novasObservacoes);
          break;
        }
      }
      
      if (!encontrado) {
        throw new Error(`Pedido #${idPedido} não encontrado na planilha`);
      }
      
      return criarResposta({
        sucesso: true,
        mensagem: 'Observações atualizadas com sucesso!',
        id_pedido: idPedido,
        observacoes: novasObservacoes
      });
    }

    // ============================================================
    // 2.16 ATUALIZAR PEDIDO COMPLETO
    // ============================================================
    if (acao === 'atualizar_pedido_completo') {
      const sheet = ss.getSheetByName('pedidos');
      
      if (!sheet) {
        throw new Error('Aba "pedidos" não encontrada');
      }
      
      const cabecalhos = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
      const colunaId = cabecalhos.indexOf('id_pedido') + 1;
      
      const idPedido = parseInt(dados.id_pedido);
      let linhaEncontrada = -1;
      
      for (let i = 2; i <= sheet.getLastRow(); i++) {
        const idCelula = sheet.getRange(i, colunaId).getValue();
        if (parseInt(idCelula) === idPedido) {
          linhaEncontrada = i;
          break;
        }
      }
      
      if (linhaEncontrada === -1) {
        throw new Error('Pedido #' + idPedido + ' não encontrado');
      }
      
      const camposPermitidos = {
        'cliente_nome': dados.cliente_nome,
        'cliente_email': dados.cliente_email,
        'cliente_telefone': dados.cliente_telefone,
        'endereco_entrega': dados.endereco_entrega,
        'status': dados.status,
        'observacoes': dados.observacoes
      };
      
      for (const [nomeColuna, valor] of Object.entries(camposPermitidos)) {
        if (valor !== undefined && valor !== null) {
          const coluna = cabecalhos.indexOf(nomeColuna) + 1;
          if (coluna > 0) {
            sheet.getRange(linhaEncontrada, coluna).setValue(valor);
            console.log('✅ Atualizado: ' + nomeColuna + ' = ' + valor);
          }
        }
      }
      
      return criarResposta({
        sucesso: true,
        mensagem: 'Pedido #' + idPedido + ' atualizado com sucesso!'
      });
    }

    // ============================================================
    // 2.17 ATUALIZAR STATUS + RASTREIO (DUPLICADO - MANTIDO POR SEGURANÇA)
    // ============================================================
    if (acao === 'atualizar_status_pedido') {
      const sheet = ss.getSheetByName('pedidos');
      
      if (!sheet) {
        throw new Error('Aba "pedidos" não encontrada');
      }
      
      const cabecalhos = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
      const colunaId = cabecalhos.indexOf('id_pedido') + 1;
      const colunaStatus = cabecalhos.indexOf('status') + 1;
      const colunaObservacoes = cabecalhos.indexOf('observacoes') + 1;
      
      const idPedido = parseInt(dados.id_pedido);
      const novoStatus = dados.status;
      const codigoRastreio = dados.rastreio || '';
      const observacoesAdicionais = dados.observacoes || '';
      
      let linhaEncontrada = -1;
      
      for (let i = 2; i <= sheet.getLastRow(); i++) {
        const idCelula = sheet.getRange(i, colunaId).getValue();
        if (parseInt(idCelula) === idPedido) {
          linhaEncontrada = i;
          break;
        }
      }
      
      if (linhaEncontrada === -1) {
        throw new Error('Pedido #' + idPedido + ' não encontrado');
      }
      
      sheet.getRange(linhaEncontrada, colunaStatus).setValue(novoStatus);
      console.log('✅ Status atualizado para: ' + novoStatus);
      
      if (novoStatus === 'Enviado' && codigoRastreio) {
        let observacoesAtuais = sheet.getRange(linhaEncontrada, colunaObservacoes).getValue() || '';
        
        observacoesAtuais = observacoesAtuais.replace(/\s*\|\s*Rastreio:\s*[A-Za-z0-9]+/gi, '');
        observacoesAtuais = observacoesAtuais.replace(/\s*\|\s*$/g, '');
        observacoesAtuais = observacoesAtuais.trim();
        
        if (observacoesAtuais && !observacoesAtuais.endsWith('|')) {
          observacoesAtuais += ' | ';
        }
        observacoesAtuais += 'Rastreio: ' + codigoRastreio;
        
        if (observacoesAdicionais) {
          observacoesAtuais += ' | ' + observacoesAdicionais;
        }
        
        sheet.getRange(linhaEncontrada, colunaObservacoes).setValue(observacoesAtuais);
        console.log('✅ Rastreio salvo: ' + codigoRastreio);
        console.log('✅ Observações atualizadas: ' + observacoesAtuais);
        
      } else if (observacoesAdicionais) {
        let observacoesAtuais = sheet.getRange(linhaEncontrada, colunaObservacoes).getValue() || '';
        
        observacoesAtuais = observacoesAtuais.replace(/\s*\|\s*Rastreio:\s*[A-Za-z0-9]+/gi, '');
        observacoesAtuais = observacoesAtuais.replace(/\s*\|\s*$/g, '');
        observacoesAtuais = observacoesAtuais.trim();
        
        if (observacoesAtuais && !observacoesAtuais.endsWith('|')) {
          observacoesAtuais += ' | ';
        }
        observacoesAtuais += observacoesAdicionais;
        
        sheet.getRange(linhaEncontrada, colunaObservacoes).setValue(observacoesAtuais);
        console.log('✅ Observações adicionais salvas: ' + observacoesAdicionais);
      }
      
      return criarResposta({
        sucesso: true,
        mensagem: 'Status atualizado com sucesso!'
      });
    }
    
    // ============================================================
    // RESPOSTA PADRÃO
    // ============================================================
    return criarResposta({
      sucesso: false,
      erro: 'Ação desconhecida: ' + acao
    });
    
  } catch (error) {
    return criarResposta({
      sucesso: false,
      erro: error.message,
      stack: error.stack
    });
  }
}

