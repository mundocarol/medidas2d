// WEBHOOK PARA RECEBER NOTIFICAÇÕES DO PAGAR.ME
// ============================================================
function doPostPagarMe(e) {
  try {
    if (!e || !e.postData) {
      return ContentService.createTextOutput(JSON.stringify({ 
        error: 'Requisição inválida' 
      })).setMimeType(ContentService.MimeType.JSON);
    }
    
    var data = JSON.parse(e.postData.contents);
    console.log('📨 Webhook recebido:', JSON.stringify(data));
    
    if (data.type === 'order.paid' || data.type === 'payment.link.paid') {
      var pedidoId = data.data && data.data.metadata && data.data.metadata.pedido_id;
      var checkoutId = data.data && data.data.id;
      
      if (pedidoId) {
        console.log('✅ Pedido #' + pedidoId + ' pago! Checkout ID: ' + checkoutId);
        
        atualizarStatusPedidoPlanilha(pedidoId, 'Pago', checkoutId);
        
        return ContentService.createTextOutput(JSON.stringify({ 
          success: true, 
          message: 'Pedido #' + pedidoId + ' atualizado para PAGO'
        })).setMimeType(ContentService.MimeType.JSON);
      }
    }
    
    return ContentService.createTextOutput(JSON.stringify({ 
      success: true, 
      message: 'Webhook recebido' 
    })).setMimeType(ContentService.MimeType.JSON);
    
  } catch (error) {
    console.error('❌ Erro no webhook:', error);
    return ContentService.createTextOutput(JSON.stringify({ 
      error: error.message 
    })).setMimeType(ContentService.MimeType.JSON).setStatusCode(500);
  }
}

// ============================================================
// ATUALIZAR STATUS DO PEDIDO NA PLANILHA
// ============================================================
function atualizarStatusPedidoPlanilha(pedidoId, novoStatus, checkoutId) {
  try {
    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = spreadsheet.getSheetByName('pedidos');
    
    if (!sheet) {
      console.error('❌ Planilha "pedidos" não encontrada');
      return false;
    }
    
    var data = sheet.getDataRange().getValues();
    var headers = data[0];
    
    var colId = headers.indexOf('id_pedido');
    var colStatus = headers.indexOf('status');
    
    if (colId === -1 || colStatus === -1) {
      console.error('❌ Colunas "id_pedido" ou "status" não encontradas');
      return false;
    }
    
    colId++;
    colStatus++;
    
    for (var i = 1; i < data.length; i++) {
      var idAtual = String(data[i][colId - 1]).trim();
      if (idAtual === String(pedidoId)) {
        sheet.getRange(i + 1, colStatus).setValue(novoStatus);
        console.log('✅ Pedido #' + pedidoId + ' atualizado para "' + novoStatus + '" na planilha');
        return true;
      }
    }
    
    console.warn('⚠️ Pedido #' + pedidoId + ' não encontrado na planilha');
    return false;
    
  } catch (error) {
    console.error('❌ Erro ao atualizar status na planilha:', error);
    return false;
  }
}

