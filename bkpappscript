// ============================================================
// CACHE PARA FRETE (ARMAZENAMENTO TEMPORÁRIO)
// ============================================================
var cacheFrete = {};
var cacheFreteTempo = 300000; // 5 minutos em milissegundos

function salvarCacheFrete(chave, dados) {
  cacheFrete[chave] = {
    dados: dados,
    timestamp: Date.now()
  };
  for (var key in cacheFrete) {
    if (Date.now() - cacheFrete[key].timestamp > cacheFreteTempo) {
      delete cacheFrete[key];
    }
  }
}

function buscarCacheFrete(chave) {
  if (cacheFrete[chave] && (Date.now() - cacheFrete[chave].timestamp < cacheFreteTempo)) {
    return cacheFrete[chave].dados;
  }
  return null;
}


